{
  "name": "optiflow-ctrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard-no-frontier-api.mjs",
    "check": "pnpm guard && pnpm typecheck && pnpm test",
    "eval": "tsx src/eval/cli.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
