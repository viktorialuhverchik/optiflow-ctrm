{
  "name": "optiflow-ctrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard-no-frontier-api.mjs",
    "check": "pnpm guard && pnpm typecheck && pnpm test",
    "eval": "tsx src/eval/cli.ts",
    "model:smoke": "tsx src/llm/smoke.ts",
    "model:verify": "tsx src/llm/verify.ts",
    "grammar:check": "tsx src/llm/grammar-check.ts",
    "extract": "tsx src/cli.ts",
    "eval:compare": "tsx src/eval/compare.ts",
    "eval:rescore": "tsx src/eval/rescore.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "tsx src/mcp/smoke.ts",
    "mcp:demo": "tsx src/mcp/demo.ts",
    "eval:configs": "tsx src/eval/compare-configs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "decimal.js": "^10.4.3",
    "node-llama-cpp": "^3.20.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-llama-cpp"
    ]
  }
}
